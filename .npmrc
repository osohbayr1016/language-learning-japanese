# pnpm — still used by apps/* until they are folded into src/ and deleted.
node-linker=hoisted

# npm — the website.
# @expo/vector-icons and @react-native-async-storage/async-storage declare a
# peer dependency on react-native. This is a website: vite.config.ts aliases
# `react-native` to `react-native-web`, so React Native is never installed or
# bundled and that peer requirement is not real here. Without this, npm tries to
# satisfy it with react-native@0.87, which demands react@^19.2 and conflicts
# with the pinned react@19.1.0.
legacy-peer-deps=true
