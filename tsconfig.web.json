{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@src/*": ["apps/mobile/src/*"],
      "@screens/*": ["apps/mobile/app/*"],
      "@japanese-learning/types": ["packages/types/src/index.ts"],
      "@japanese-learning/srs": ["packages/srs/src/index.ts"]
    }
  },
  "include": ["src/app", "src/main.tsx", "src/pwa", "apps/mobile/app", "apps/mobile/src", "packages/srs/src", "packages/types/src"],
  "exclude": ["src/compat", "node_modules"]
}
