{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@src/*": [
        "apps/mobile/src/*"
      ],
      "@screens/*": [
        "apps/mobile/app/*"
      ],
      "expo-router": [
        "src/compat/expo-router.tsx"
      ],
      "@japanese-learning/types": [
        "packages/types/src/index.ts"
      ],
      "@japanese-learning/srs": [
        "packages/srs/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
