/stroke-data/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400
/dictionary/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
/reset-password
  Referrer-Policy: no-referrer
