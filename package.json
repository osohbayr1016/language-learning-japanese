{
  "name": "japanese-learning-monorepo",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "api:dev": "npm --prefix apps/api run dev",
    "api:deploy": "npm --prefix apps/api run deploy",
    "legacy:mobile": "npm --prefix apps/mobile run start",
    "deploy": "npm run build && wrangler deploy --env production",
    "deploy:preview": "npm run build && wrangler versions upload --env production",
    "api:typecheck": "tsc --noEmit -p apps/api/tsconfig.json",
    "api:migrate": "cd apps/api && wrangler d1 migrations apply nihongo-mn-db --local",
    "test": "node --import tsx --test packages/curriculum/tests/*.test.ts apps/api/tests/*.test.ts apps/mobile/tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:isolation": "node scripts/check-japanese-isolation.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260430.1",
    "@playwright/test": "1.55.0",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@types/react-native-web": "^0.19.3",
    "@vitejs/plugin-react": "^5.0.0",
    "hono": "^4.13.18",
    "react-native": "^0.81.5",
    "tsx": "^4.21.0",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "wrangler": "^4.87.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@japanese-learning/srs": "file:packages/srs",
    "@japanese-learning/types": "file:packages/types",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.2",
    "react-router-dom": "^7.1.1"
  }
}
